{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-store-fit-source",
    "allow-read-fit-source",
    "allow-inspect-plan-draft",
    "allow-save-plan-draft",
    "allow-read-plan-draft",
    "allow-export-plan-draft",
    "allow-save-plan-draft-recovery",
    "allow-save-plan-conversion-file",
    "allow-recover-plan-draft",
    "allow-replace-legacy-snapshot",
    "allow-garmin-status",
    "allow-garmin-connect",
    "allow-garmin-verify",
    "allow-garmin-disconnect",
    "allow-garmin-list-activities",
    "allow-garmin-retrieve-activity",
    "allow-garmin-cancel",
    "allow-garmin-open-key-page",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}
