{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stride Plan",
  "version": "0.1.0",
  "identifier": "com.strideplan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stride Plan",
        "width": 1360,
        "height": 860,
        "minWidth": 680,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": [] }
}
